{
    "name": "kevinlaveto/laravel-hostfact",
    "description": "HostFact for Laravel",
    "keywords": ["hostfact", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0.1"
    },
    "require-dev": {
        "phpunit/phpunit" : "^9.3.3|^10.0|^11.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "nickurt\\HostFact\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "kevinlaveto\\HostFact\\tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "nickurt\\HostFact\\ServiceProvider"
            ],
            "aliases": {
                "HostFact": "nickurt\\HostFact\\Facade"
            }
        }
    }
}
